{
  "name": "arkeanos-hardcore-tiktok",
  "version": "1.0.0",
  "private": true,
  "description": "Video vertical 9:16 para TikTok promocionando el modo HARDCORE de Arkeanos World, hecho con Remotion",
  "scripts": {
    "dev": "remotion studio",
    "audio": "python3 scripts/generate_audio.py",
    "render": "remotion render HardcoreTikTok out/arkeanos-hardcore.mp4",
    "still": "remotion still HardcoreTikTok out/preview.png --frame=300",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/google-fonts": "4.0.534",
    "@remotion/transitions": "4.0.534",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}
